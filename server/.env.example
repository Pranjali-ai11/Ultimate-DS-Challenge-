NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# MySQL 8 connection string. URL-encode special characters in the username/password.
DATABASE_URL=mysql://udsc_app:replace_with_a_local_password@127.0.0.1:3306/ultimate_ds_challenge

# Generate a unique random value (at least 32 characters). Do not commit it.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters

# Optional, isolated MySQL database used only by integration tests.
TEST_DATABASE_URL=mysql://udsc_test:replace_with_a_local_password@127.0.0.1:3306/ultimate_ds_challenge_test
